<!DOCTYPE html>

<html data-theme="autumn">
    <head>
        <title>Veez</title>

        <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
        <link rel="stylesheet" href="/css/main.css" />
    </head>

    <body>
        <%- include('partials/navbar.ejs') %>

        <div class="container mx-auto mt-5 mb-10 px-5 md:px-20">
            <div class="hero bg-base-200 min-h-64 rounded-lg">
                <div class="hero-content text-center w-full">
                    <div class="max-w-xl">
                        <h1 class="text-6xl text-base-content font-bold">Visual Stories</h1>
                        <p class="pt-6 text-base-content">Below are some categories of my favorite stories to explore.</p>
                        <p class="pb-4 text-base-content">Click on a button below to filter by a specific category.</p>
                        <a href="/media?category=manga" class="btn btn-primary">Manga</a>
                        <a href="/media?category=anime" class="btn btn-primary">Anime</a>
                        <a href="/media?category=manhwa" class="btn btn-primary">Manhwa</a>
                    </div>
                </div>
            </div>

            <br><br>

            <div class="bg-base-200 rounded-lg relative flex w-fit p-1">
                <input id="table" type="radio" name="view" class="peer/table hidden" checked>
                <label for="table" class="relative z-10 w-10 h-8 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0 1 12 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 0h7.5" />
                    </svg>
                </label>

                <input id="cards" type="radio" name="view" class="peer/cards hidden">
                <label for="cards" class="relative z-10 w-10 h-8 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                    </svg>
                </label>

                <div class="absolute top-1 left-1 w-10 h-8 bg-base-100 rounded-md shadow-sm transition-transform duration-300 ease-in-out
                    peer-checked/table:translate-x-0
                    peer-checked/cards:translate-x-full">
                </div>
            </div>

            <br><br>

            <div id="cardGroup" class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                <% media.forEach((mediaObj) => { %>
                    <a href="/media/<%= mediaObj.id %>">
                        <div class="card bg-base-100 shadow-md transition-transform duration-75 hover:shadow-lg hover:scale-101 hover:bg-primary hover:text-primary-content">
                            <figure class="aspect-[3/4] overflow-hidden">
                                <img
                                    class="w-full h-full object-cover"
                                    src="<%= mediaObj.coverImage.large %>"
                                    alt="media cover image" />
                            </figure>
                            <div class="card-body">
                                <h2 class="card-title block truncate text-center"><%= mediaObj.title.english ? mediaObj.title.english : mediaObj.title.romaji %></h2>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>

            <div id="tableGroup" class="rounded-box border border-base-primary bg-base-200">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Genres</th>
                            <th>Learn More</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% media.forEach((mediaObj) => { %>
                            <tr>
                                <td class="font-bold"><%= mediaObj.title.english ? mediaObj.title.english : mediaObj.title.romaji %></td>
                                <td><a class="btn btn-secondary" href="/media?category=<%= mediaObj.category %>"><%= mediaObj.category %></a></td>
                                <td><%= mediaObj.genres?.join(", ") %></td>
                                <td><a class="btn btn-secondary" href="/media/<%= mediaObj.id %>">details</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <script>
            let tableButton = document.getElementById('table')
            let cardsButton = document.getElementById('cards')
            let cards = document.getElementById('cardGroup')
            let table = document.getElementById('tableGroup')

            function changeView() {
                table.classList.toggle('hidden')
                cards.classList.toggle('hidden')
            }

            tableButton.addEventListener('change', changeView)
            cardsButton.addEventListener('change', changeView)
        </script>
    </body>
</html>