<!DOCTYPE html>

<html data-theme="autumn">
    <head>
        <title>Veez</title>

        <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
        <link rel="stylesheet" href="/css/main.css" />
    </head>

    <body>
        <%- include('partials/navbar.ejs') %>
        <% let title = mediaObj.title?.english || mediaObj.title?.romaji || 'Untitled' %>

        <div class="container mx-auto mt-5 mb-10 px-5 md:px-20">
            <div class="hero bg-base-200 min-h-64 rounded-lg overflow-hidden mb-10" <%- mediaObj.bannerImage ? `style="background-image: url(${mediaObj.bannerImage});"` : '' %>>
                <%- mediaObj.bannerImage ? '<div class="hero-overlay"></div>' : '' %>

                <div class="hero-content text-center w-full <%= mediaObj.bannerImage ? 'text-neutral-content' : 'text-base-content' %>">
                    <div class="max-w-xl">
                        <h1 class="text-6xl font-bold"><%= title %></h1>
                        <p class="pt-6">More information about <%= title %> below:</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 justify-items-center md:justify-items-end">
                <figure class="aspect-[3/4] overflow-hidden rounded-xl w-3/4">
                    <img
                        class="w-full h-full object-cover"
                        src="<%= mediaObj.coverImage.extraLarge %>"
                        alt="media cover image" />
                </figure>

                <div class="mr-20">
                    <p><%- mediaObj.description %></p>

                    <br>
                    <br>

                    <p>More information found on the official AniList page:</p>
                    <p>
                        <a class="link" href="<%= mediaObj.siteUrl %>" target="_blank"><%= mediaObj.siteUrl %></a>
                    </p>
                    
                    <br>

                    <a class="btn btn-primary" href="#" onclick="history.back(); return false;">Back</a>
                </div>
            </div>
        </div>
    </body>
</html>